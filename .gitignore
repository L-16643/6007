# macOS 本地文件
.DS_Store
._*

# Python 虚拟环境、缓存与构建产物
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
tmp/
build/
dist/
*.egg-info/

# 测试覆盖率与 Notebook 缓存
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# 本地环境变量
.env
.env.*
!.env.example
!.env.template

# 数据与生成的数组（用 scripts/prepare_data.py 重新生成）
data/raw/
data/sample/
data/processed*/
results/*_sample/
# LaTeX 编译中间文件
*.aux
*.log
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
results/sensitivity/*/checkpoints/
results/sensitivity/*/.writer.lock
# E smoke-test and timing outputs can be regenerated locally.
results/figures/e_sample/
results/sensitivity/e_sample/
results/sensitivity/e_pilot/
